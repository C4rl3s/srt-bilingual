# Plantilla de variables de entorno del backend.
# Copia este fichero a `.env` y rellena los valores reales (no lo subas a git).

# --- Servidor ---
# HOST=0.0.0.0
# PORT=8000

# --- Base de datos (Fase 1) ---
# DATABASE_URL=sqlite:///./srt_bilingual.db

# Las carpetas a escanear NO se configuran aquí: se añaden desde la interfaz
# y viven en la tabla `library_folder`.

# --- Traducción (Fase 3) ---
# Proveedor activo. Hoy solo `deepl`; la app está pensada para añadir otros
# (Azure, Google…) sin tocar nada más que `services/translation/`.
# TRANSLATION_PROVIDER=deepl

# Clave de la API de DeepL: https://www.deepl.com/es/your-account/keys
# Quita el `#` y pega la clave después del `=`, sin comillas.
# DEEPL_API_KEY=
# DEFAULT_TARGET_LANG=KO

# Carpeta alternativa para los bilingües. Vacía (lo normal): se escriben junto al
# vídeo, que es donde Plex los busca. Solo para bibliotecas de solo lectura.
# OUTPUT_DIR=
